{
  "name": "@eflexsystems/ember-tracked-validations",
  "version": "9.0.0",
  "description": "Ember computed property based validation library",
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "npm-run-all lint test:*",
    "test:ember": "ember test",
    "test:ember-compatibility": "ember try:each"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@embroider/macros": "~1.16.13",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-validators": "^4.1.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.27.3",
    "@ember/optional-features": "^2.2.0",
    "@ember/string": "^3.1.1",
    "@ember/test-helpers": "^4.0.5",
    "@embroider/test-setup": "^4.0.0",
    "@fortawesome/ember-fontawesome": "^1.0.3",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "bootstrap": "^5.3.6",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.10.0",
    "ember-bootstrap": "^6.5.0",
    "ember-cli": "~6.4.0",
    "ember-cli-app-version": "^6.0.0",
    "ember-cli-autoprefixer": "^2.0.0",
    "ember-cli-code-coverage": "^2.0.0",
    "ember-cli-dependency-checker": "^3.3.3",
    "ember-cli-github-pages": "^0.2.2",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^11.0.1",
    "ember-cli-terser": "^4.0.2",
    "ember-cli-yuidoc": "^0.9.1",
    "ember-code-snippet": "^3.0.0",
    "ember-data": "~5.2.0",
    "ember-load-initializers": "^2.1.2",
    "ember-qunit": "^9.0.3",
    "ember-resolver": "^12.0.1",
    "ember-source": "~6.5.0",
    "ember-source-channel-url": "^3.0.0",
    "ember-template-lint": "^6.1.0",
    "ember-test-selectors": "^6.0.0",
    "ember-truth-helpers": "^4.0.3",
    "ember-try": "^4.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-ember": "^12.5.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-qunit": "^8.1.2",
    "loader.js": "^4.7.0",
    "moment": "^2.30.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "sass": "^1.86.3",
    "webpack": "^5.99.5",
    "yuidoc-ember-theme": "^2.0.1"
  },
  "peerDependencies": {
    "ember-source": ">= 5.0.0",
    "ember-data": "*"
  },
  "keywords": [
    "ember-addon",
    "ember-data",
    "validator",
    "validation",
    "model",
    "input",
    "form"
  ],
  "repository": {
    "type": "git",
    "url": "http://github.com/eflexsystems/ember-tracked-validations.git"
  },
  "license": "MIT",
  "author": "Jacob Jewell <jacobjewell@eflexsystems.com>",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "configPath": "tests/dummy/config",
    "demoURL": "http://offirgolan.github.io/ember-cp-validations"
  },
  "homepage": "https://github.com/offirgolan/ember-cp-validations"
}
